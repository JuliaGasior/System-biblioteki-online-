@model IEnumerable<SystemBibliotekiOnline.Models.DbModels.Book>

<h2>Katalog książek</h2>

<form method="get">
    <div class="input-group mb-4">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Szukaj książki..." />

        <select name="categoryId" class="form-select">
            <option value="">Wszystkie kategorie</option>

            @foreach (var category in ViewBag.Categories)
            {
                    <option value="@category.CategoryId">
                    @category.Name
                    </option>
            }
        </select>

        <button class="btn btn-primary">Filtruj</button>
    </div>
</form>

<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(book.CoverImagePath))
                {
                        <img src="/uploads/books/@book.CoverImagePath"
                             class="card-img-top book-cover" />
                }
                else
                {
                        <img src="/images/no-book.png"
                             class="card-img-top book-cover" />
                }

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">@book.Title</h5>

                    <p class="text-muted">
                        @book.Author.Name @book.Author.Surname
                    </p>

                    @if (!string.IsNullOrWhiteSpace(book.Description))
                    {
                            <p class="book-description">
                            @book.Description
                            </p>
                    }

                    <p>
                        <span class="badge bg-secondary">
                            @book.Category.Name
                        </span>
                    </p>

                    <div class="mt-auto">

                        @if (book.IsAvailable)
                        {
                                <span class="badge bg-success mb-2">Dostępna</span>
                        }
                        else
                        {
                                <span class="badge bg-danger mb-2">Wypożyczona</span>
                        }

                        <a class="btn btn-outline-primary w-100 mb-2"
                           asp-action="Details"
                           asp-route-id="@book.BookId">
                            Dowiedz się więcej
                        </a>

                        @if (User.Identity?.IsAuthenticated == true && book.IsAvailable)
                        {
                                <form asp-controller="Loans"
                                      asp-action="Borrow"
                                      method="post">
                                    <input type="hidden"
                                           name="bookId"
                                           value="@book.BookId" />

                                    <button class="btn btn-primary w-100">
                                        Wypożycz
                                    </button>
                                </form>
                        }

                    </div>
                </div>
            </div>
        </div>
    }
</div>