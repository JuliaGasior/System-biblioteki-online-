@model SystemBibliotekiOnline.Models.DbModels.Book

<h2>@Model.Title</h2>

<div class="row">

    <div class="col-md-4">

        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
        {
                <img src="/uploads/books/@Model.CoverImagePath"
                     class="img-fluid rounded shadow" />
        }

    </div>

    <div class="col-md-8">

        <p>
            <strong>Autor:</strong>
            @Model.Author.Name @Model.Author.Surname
        </p>

        <p>
            <strong>Kategoria:</strong>
            @Model.Category.Name
        </p>

        <p>
            <strong>Rok wydania:</strong>
            @Model.PublicationYear
        </p>

        <p>
            <strong>ISBN:</strong>
            @Model.ISBN
        </p>

        <hr />

        <h4>Opis książki</h4>

        <p>
            @Model.Description
        </p>

    </div>

</div>