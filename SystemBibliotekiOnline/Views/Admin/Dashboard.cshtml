<h2>Panel administratora</h2>

<div class="row">

    <div class="col-md-3 mb-3">

        <div class="card text-center">

            <div class="card-body">

                <h3>@ViewBag.Books</h3>
                <p>Książki</p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card text-center">

            <div class="card-body">

                <h3>@ViewBag.Authors</h3>
                <p>Autorzy</p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card text-center">

            <div class="card-body">

                <h3>@ViewBag.Categories</h3>
                <p>Kategorie</p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card text-center">

            <div class="card-body">

                <h3>@ViewBag.ActiveLoans</h3>
                <p>Aktywne wypożyczenia</p>

            </div>

        </div>

    </div>

    <div class="col-md-3 mb-3">

        <div class="card text-center">

            <div class="card-body">

                <h3>@ViewBag.OverdueLoans</h3>
                <p>Przeterminowane wypożyczenia</p>

            </div>

        </div>

    </div>

</div>