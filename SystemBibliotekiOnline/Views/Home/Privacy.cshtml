@{
    ViewData["Title"] = "Polityka prywatności";
}

<div class="container mt-4">

    <h1 class="mb-4">Polityka prywatności</h1>

    <div class="card p-4 shadow-sm">

        <p>
            System Biblioteki Online przetwarza dane użytkowników wyłącznie
            w celu obsługi konta oraz wypożyczeń książek.
        </p>

        <h3>Przykładowe dane przechowywane w systemie</h3>

        <ul>
            <li>Adres e-mail</li>
            <li>Historia wypożyczeń</li>
        </ul>

        <h3>Przykładowy regulamin</h3>

        <p>
            1. Użytkownik może wypożyczyć maksymalnie 5 książek jednocześnie.
        </p>

        <p>
            2. Termin zwrotu książki wynosi 30 dni.
        </p>

        <p>
            3. Administrator ma prawo zarządzać zasobami biblioteki.
        </p>

    </div>

</div>